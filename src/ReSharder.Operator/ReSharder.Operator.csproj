<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ReSharder.Operator</RootNamespace>
    <AssemblyName>ReSharder.Operator</AssemblyName>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- IL trimming configuration is provided in linker.xml. Suppress assembly-level IL2104
         warnings from third-party libraries that run their own trim analysis while
         preserving the concrete types our app needs. This keeps diagnostics for
         actionable RequiresUnreferencedCode (IL2026) visible but avoids noisy
         assembly-level warnings. -->
    <NoWarn>IL2104</NoWarn>
    <SignAssembly>False</SignAssembly>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReSharder.Operator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensure the trimmer keeps types required at runtime by reflection/serialization -->
    <TrimmerRootDescriptor Include="linker.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer.Core" Version="3.0.1" />
    <PackageReference Include="KubeOps.Operator" Version="13.3.1" />
    <PackageReference Include="KubeOps.Generator" Version="13.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
